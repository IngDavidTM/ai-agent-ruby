<div class="liquid-background">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
</div>

<div class="glass-landing">
  <%= render 'shared/landing_navbar' %>

  <div class="container" style="max-width: 1000px; margin: 0 auto; text-align: center; position: relative; z-index: 2;">
    <h1 style="font-size: 3rem; margin-bottom: 40px;">System <span class="gradient-text">Capabilities</span></h1>

    <div class="features-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; text-align: left;">
      
      <!-- Feature 1 -->
      <div class="glass-card feature-card" style="padding: 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); transition: transform 0.3s; backdrop-filter: blur(10px);">
        <div class="icon" style="font-size: 2.5rem; margin-bottom: 20px;">🧠</div>
        <h3 style="margin-top: 0; font-size: 1.5rem;">Smart Context</h3>
        <p style="color: rgba(255,255,255,0.7); line-height: 1.6;">
          Efficiency optimized memory. The agent retains the last 20 messages for precise context without token overflow.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="glass-card feature-card" style="padding: 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); transition: transform 0.3s; backdrop-filter: blur(10px);">
        <div class="icon" style="font-size: 2.5rem; margin-bottom: 20px;">⚡</div>
        <h3 style="margin-top: 0; font-size: 1.5rem;">Instant Response</h3>
        <p style="color: rgba(255,255,255,0.7); line-height: 1.6;">
          Asynchronous architecture (AJAX) provides a seamless "Liquid" chat experience with no page reloads.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="glass-card feature-card" style="padding: 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); transition: transform 0.3s; backdrop-filter: blur(10px);">
        <div class="icon" style="font-size: 2.5rem; margin-bottom: 20px;">💻</div>
        <h3 style="margin-top: 0; font-size: 1.5rem;">Code Native</h3>
        <p style="color: rgba(255,255,255,0.7); line-height: 1.6;">
          Built for developers. Syntax highlighting, monospaced fonts, and one-click copy for all code blocks.
        </p>
      </div>

      <!-- Feature 4 -->
      <div class="glass-card feature-card" style="padding: 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); transition: transform 0.3s; backdrop-filter: blur(10px);">
        <div class="icon" style="font-size: 2.5rem; margin-bottom: 20px;">🛡️</div>
        <h3 style="margin-top: 0; font-size: 1.5rem;">Secure Core</h3>
        <p style="color: rgba(255,255,255,0.7); line-height: 1.6;">
          Built with Rails Strong Parameters and robust error handling to ensure stability and safety.
        </p>
      </div>
       
      <!-- Feature 5 -->
      <div class="glass-card feature-card" style="padding: 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); transition: transform 0.3s; backdrop-filter: blur(10px);">
        <div class="icon" style="font-size: 2.5rem; margin-bottom: 20px;">🎨</div>
        <h3 style="margin-top: 0; font-size: 1.5rem;">Liquid UI</h3>
        <p style="color: rgba(255,255,255,0.7); line-height: 1.6;">
          A custom Glassmorphism design system inspired by iOS 26 concepts, featuring real-time blur and fluid animations.
        </p>
      </div>

       <!-- Feature 6 -->
      <div class="glass-card feature-card" style="padding: 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.03); transition: transform 0.3s; backdrop-filter: blur(10px);">
        <div class="icon" style="font-size: 2.5rem; margin-bottom: 20px;">🤖</div>
        <h3 style="margin-top: 0; font-size: 1.5rem;">Multimodal</h3>
        <p style="color: rgba(255,255,255,0.7); line-height: 1.6;">
          Powered by Google Gemini 1.5 Flash, capable of understanding complex context and generating creative solutions.
        </p>
      </div>

    </div>
  </div>
</div>
